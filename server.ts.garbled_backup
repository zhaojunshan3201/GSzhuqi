    ELSE
      ROUND(a.rcsl / (a.rcyl + a.rcsl + 0.0001) * 100, 0)
  END as "water_cut",
  ROUND((NVL(a.rcbsq, 0) + NVL(a.rcql, 0)), 0) as "gas"
`;

