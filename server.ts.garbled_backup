        `
          SELECT
            rq as "date",
            ROUND(SUM(liquid), 1) as "liquid",
            ROUND(SUM(oil), 1) as "oil",
            ROUND(SUM(diluent), 1) as "diluent",
            ${SQLITE_SUMMARY_WATER_CUT_SQL} as "water_cut",
