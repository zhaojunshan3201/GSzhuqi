function decodeMeasureCsvBuffer(buffer: Buffer) {
  const utf8Text = new TextDecoder("utf-8").decode(buffer);
  if (!utf8Text.includes("___?")) {
    return utf8Text;
  }

  try {
    return new TextDecoder("gb18030").decode(buffer);
  } catch {
    return utf8Text;
  }
}

